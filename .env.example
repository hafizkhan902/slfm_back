# ===================================================
# ShahLajuk Furniture Mart - Backend Environment Example
# Copy this file to .env and fill in your credentials
# ===================================================

PORT=5005
NODE_ENV=development

# MongoDB Connection String (Atlas or Local instance)
MONGO_URI=mongodb+srv://YOUR_MONGO_USERNAME:YOUR_MONGO_PASSWORD@cluster0.ysf0qjq.mongodb.net/shahlajuk_db?retryWrites=true&w=majority

# Redis Caching Connection URI (Optional)
REDIS_URI=redis://127.0.0.1:6379

# JSON Web Token Secret Key & Expiration
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY
JWT_EXPIRE=30d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
CLOUDINARY_URL=cloudinary://YOUR_CLOUDINARY_API_KEY:YOUR_CLOUDINARY_API_SECRET@YOUR_CLOUDINARY_CLOUD_NAME

# Cross-Origin Resource Sharing
CORS_ORIGIN=http://localhost:5173

# BD-GeoAPI Configuration (Bangladesh Administrative Areas)
BD_GEO_API_URL=https://bdgeoapi.rajumia.com/api/v1
